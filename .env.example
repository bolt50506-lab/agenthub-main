# Supabase
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# WhatsApp QR Baileys Service (local Node.js service running on port 3001)
WHATSAPP_QR_SERVICE_URL=http://localhost:3001

# Ollama (local AI inference, default port 11434)
# Optional - only needed if using Ollama as AI provider
OLLAMA_URL=http://localhost:11434

# AI Provider API Keys (optional - configure via admin panel instead)
# GEMINI_API_KEY=your key here
# GROQ_API_KEY=your_groq_api_key_here


# AgentHub checkout security
# Random private secret used to encrypt a pending checkout password until verified payment
CHECKOUT_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Secret used by the daily subscription lifecycle job
CRON_SECRET=replace-with-a-long-random-secret
# Public production URL, e.g. https://agenthubai.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configure your chosen Pakistani payment gateway credentials here.
# Do not add these credentials to NEXT_PUBLIC_* variables.
# The checkout code must be connected to the merchant API/webhook supplied by
# your approved JazzCash, Easypaisa or other Pakistani gateway account.


# WhatsApp follow-up delivery service (server-side only)
# Railway URL of the already-working WhatsApp agent, for example https://your-agent.up.railway.app
WHATSAPP_AGENT_URL=
# Optional bearer token if the WhatsApp agent protects /send-message
WHATSAPP_AGENT_TOKEN=
