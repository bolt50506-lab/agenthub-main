# Supabase
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Local WhatsApp QR/Baileys service
# The current WhatsApp service listens on port 8080.
WHATSAPP_QR_SERVICE_URL=http://localhost:8080
WHATSAPP_AGENT_URL=http://localhost:8080

# Ollama (local AI inference, default port 11434)
# Optional - only needed if using Ollama as AI provider
OLLAMA_URL=http://localhost:11434

# AI Provider API Keys (optional - configure via admin panel instead)
# GEMINI_API_KEY=your key here
# GROQ_API_KEY=your_groq_api_key_here

# AgentHub checkout security
CHECKOUT_ENCRYPTION_KEY=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
FOLLOWUP_CRON_SECRET=replace-with-a-long-random-secret
AGENTHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# If the WhatsApp service runs locally, its follow-up worker should use:
# AGENTHUB_URL=http://localhost:3000
