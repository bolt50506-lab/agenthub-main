# Supabase
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# WhatsApp QR Baileys Service (local Node.js service running on port 3001)
WHATSAPP_QR_SERVICE_URL=http://localhost:3001

# Ollama (local AI inference, default port 11434)
# Optional - only needed if using Ollama as AI provider
OLLAMA_URL=http://localhost:11434

# AI Provider API Keys (optional - configure via admin panel instead)
# GEMINI_API_KEY=your key here
# GROQ_API_KEY=your_groq_api_key_here


# AgentHub public checkout and payment activation
# Paynicorn merchant credentials - keep server-side only
PAYNICORN_APP_KEY=your_paynicorn_app_key
PAYNICORN_APP_SECRET=your_paynicorn_merchant_secret
# Random private secret used to encrypt a pending checkout password until verified payment
CHECKOUT_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Public production URL, e.g. https://agenthubai.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Configure this callback URL in the Paynicorn merchant portal:
# https://your-domain.com/api/webhooks/paynicorn
