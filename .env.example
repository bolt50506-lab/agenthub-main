# Supabase
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# WhatsApp QR Baileys Service (local Node.js service running on port 3001)
WHATSAPP_QR_SERVICE_URL=http://localhost:3001

# Ollama (local AI inference, default port 11434)
# Optional - only needed if using Ollama as AI provider
OLLAMA_URL=http://localhost:11434

# AI Provider API Keys (optional - configure via admin panel instead)
# GEMINI_API_KEY=your key here
# GROQ_API_KEY=your_groq_api_key_here
